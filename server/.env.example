PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (the deployed web app's origin)
CORS_ORIGIN=http://localhost:8081,https://khurshidbekurazaliev.github.io

# Postgres connection string. For local dev: docker compose up postgres (see
# root docker-compose.yml), or point at a free Neon/Supabase database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/awesome_tracker

# Supabase Storage, for avatar/file uploads (Project Settings -> API).
# Use the service_role key, not the anon key -- this runs server-side only.
# Uploads fail with a clear error until these are set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# Comma-separated list of emails granted access to the admin moderation
# routes (view/resolve reports, close listings). No DB role, no self-service
# way to grant it -- this env var is the only way in. Leave unset to disable
# admin access entirely.
ADMIN_EMAILS=

# Stripe Connect (Stage 4, rental listings). Test-mode keys from
# https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/webhooks. Rental listings/payments/payouts
# fail with a clear error until these are set -- everything else in the app
# works fine without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform's cut of the rental fee (not the deposit), as a percentage. 0 by default.
PLATFORM_FEE_PERCENT=0
