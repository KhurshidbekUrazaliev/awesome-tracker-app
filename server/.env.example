PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (the deployed web app's origin)
CORS_ORIGIN=http://localhost:8081,https://khurshidbekurazaliev.github.io

# Postgres connection string. For local dev: docker compose up postgres (see
# root docker-compose.yml), or point at a free Neon/Supabase database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/awesome_tracker
